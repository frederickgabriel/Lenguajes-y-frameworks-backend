<!DOCTYPE html>
<html>

<head>
    <title>Clima</title>
    <link rel="stylesheet" href="/styles/styles.css">
</head>

<body>

    <h1>🌤 Clima actual</h1>

    <div class="card">
        <p>🌡 Temperatura: <%= temp %> °C</p>
        <p>💨 Viento: <%= wind %> km/h</p>
        <p>💧 Humedad: <%= humidity %> %</p>
        <p>🌥 dia o noche : <%= isDay ? 'dia' : 'Noche' %></p>
    </div>

</body>

</html>